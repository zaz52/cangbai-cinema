{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "songbai-cinema",
  "compatibility_date": "2026-04-01",
  "main": "src/index.js",
  "triggers": {
    "crons": [
      "15 * * * *",
      "30 */6 * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "songbai-db",
      "database_id": "fc329951-718f-4539-8014-4f8b4f967474",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "weiyi.indevs.in/*",
      "zone_name": "weiyi.indevs.in"
    }
  ],
  "workers_dev": true
}
